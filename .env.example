# Copy to .env and fill in. NEVER commit the real .env (see .gitignore).
# Secrets (CNIC / password / PIN) live here only — never in code, git, fixtures,
# or audit logs. Use a TEST / your-own IRIS account, never a real client's.

# --- IRIS login (secret) ---
IRIS_CNIC=12345-1234567-1
IRIS_PASSWORD=replace-me
# Submission is a HUMAN action. The agent never reads/uses the PIN; documented
# here only so it is never accidentally placed elsewhere.
# IRIS_PIN=never-used-by-the-agent

# --- Anthropic (extraction + computer-use fallback) ---
ANTHROPIC_API_KEY=sk-ant-replace-me

# --- Supabase (shared store + job queue) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=replace-me

# --- runtime ---
# IRIS_BASE_URL=https://iris.fbr.gov.pk
# HEADLESS=true
